# JeJakos Server - Environment Variables
# Salin file ini ke .env dan isi nilainya
# JANGAN commit file .env ke git

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jejakos

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google Gemini (Chatbot)
GEMINI_API_KEY=

# Midtrans (Payment - Sandbox)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# App
CLIENT_URL=http://localhost:5173
PORT=5000
