# JeJakos Environment Variables
# Salin file ini ke .env dan isi nilainya
# JANGAN commit file .env ke git

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jejakos

# ── JWT ───────────────────────────────────────
# Buat random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Google Gemini (Chatbot) ───────────────────
# Dapatkan di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Midtrans (Payment - Sandbox) ─────────────
# Dapatkan di https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# ── Email / SMTP ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── App ──────────────────────────────────────
CLIENT_URL=http://localhost:5173
PORT=5000
