{
  "info": {
    "_postman_id": "jejakos-sprint1-api-collection",
    "name": "JeJakos API — Sprint 1",
    "description": "Koleksi Postman / Thunder Client untuk pengujian endpoint Sprint 1: Auth flow, CRUD Kos & Kamar, Pencarian & Geospasial, dan Admin Endpoints.",
